meta {
  name: Crear Usuario
  type: http
  seq: 1
}

post {
  url: {{usuarios_url}}
  body: graphql
  headers {
    Content-Type: application/json
  }
}

body:graphql {
  mutation {
    crearUsuario(input: {
      nombre: "Juan Pérez"
      email: "juan.perez@example.com"
      telefono: "+52 555 1234567"
      direccion: {
        calle: "Av. Reforma 123"
        ciudad: "CDMX"
        estado: "Ciudad de México"
        codigoPostal: "06600"
        pais: "México"
      }
    }) {
      id
      nombre
      email
      telefono
      estado
      fechaCreacion
    }
  }
}

assert {
  res.status: 200
  res.body.data.crearUsuario.id: isString
  res.body.data.crearUsuario.nombre: eq("Juan Pérez")
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Usuario creado correctamente", function() {
    expect(res.getBody().data.crearUsuario.nombre).to.equal("Juan Pérez");
  });
}
