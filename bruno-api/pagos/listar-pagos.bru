meta {
  name: Listar Pagos
  type: http
  seq: 4
}

post {
  url: {{pagos_url}}
  body: graphql
  headers {
    Content-Type: application/json
  }
}

body:graphql {
  query($usuarioId: UUID, $estado: String, $skip: Int, $limit: Int) {
    listarPagos(usuarioId: $usuarioId, estado: $estado, skip: $skip, limit: $limit) {
      items {
        id
        ordenId
        usuarioId
        monto
        moneda
        metodo
        estado
        fechaCreacion
      }
      total
    }
  }
}

vars:req {
  estado: "completado"
  skip: 0
  limit: 10
}

assert {
  res.status: 200
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
