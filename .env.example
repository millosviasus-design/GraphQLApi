# Configuración de Microservicios
# Copia este archivo como .env y ajusta los valores

# Base de datos - Usuarios
DATABASE_URL_USUARIOS=postgresql+asyncpg://postgres:postgres@localhost:5432/usuarios_db

# Base de datos - Pagos
DATABASE_URL_PAGOS=postgresql+asyncpg://postgres:postgres@localhost:5433/pagos_db

# Base de datos - Órdenes
DATABASE_URL_ORDENES=postgresql+asyncpg://postgres:postgres@localhost:5434/ordenes_db

# Base de datos - Pedidos
DATABASE_URL_PEDIDOS=postgresql+asyncpg://postgres:postgres@localhost:5435/pedidos_db

# Redis
REDIS_URL=redis://localhost:6379

# URLs de los microservicios (para API Gateway)
USUARIOS_URL=http://localhost:4001/graphql
PAGOS_URL=http://localhost:4002/graphql
ORDENES_URL=http://localhost:4003/graphql
PEDIDOS_URL=http://localhost:4004/graphql
